# Local frontend configuration (the public anon key is safe to expose).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_API_BASE_URL=http://localhost:3001

# Server configuration. Never use the service-role key in a VITE_ variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
OWNER_USER_ID=YOUR_OWNER_AUTH_USER_UUID
CLIENT_ORIGIN=http://localhost:5173
SERVER_PORT=3001

# PayPal credentials are server-only. Keep Sandbox enabled until all test cases pass.
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SERVER_ONLY_PAYPAL_SANDBOX_SECRET
PAYPAL_MODE=sandbox
PAYPAL_LIVE_PAYMENTS_ENABLED=false
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_SANDBOX_WEBHOOK_ID
CHECKOUT_SHIPPING_AMOUNT=8.00

# Server-only Cloudinary credentials. Upload limits apply per file.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_SERVER_ONLY_CLOUDINARY_API_SECRET
CLOUDINARY_IMAGE_MAX_BYTES=15000000
CLOUDINARY_VIDEO_MAX_BYTES=90000000
