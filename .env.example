# Express server
NODE_ENV=development
SERVER_PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Server-only Supabase project credentials; never use the service-role key in Vite.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# Supabase Auth user UUID permitted to use owner-only API routes.
OWNER_USER_ID=

# Public API origin compiled into the static frontend.
VITE_API_BASE_URL=http://localhost:3001
